# ============================================================
# GoaConnect Environment Template — copy to .env and fill in
# NEVER commit .env to version control
# ============================================================

# Database
POSTGRES_USER=goauser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=goaconnect
DATABASE_URL=postgresql+asyncpg://goauser:CHANGE_ME_STRONG_PASSWORD@localhost:5432/goaconnect
DATABASE_URL_SYNC=postgresql://goauser:CHANGE_ME_STRONG_PASSWORD@localhost:5432/goaconnect

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI / Models
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:7b
FAST_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text

# Optional: Cloud model adapters (leave blank to use Ollama only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
SECURITY_RATE_LIMIT_PER_MINUTE=20

# Audit
AUDIT_RETENTION_DAYS=365
SECURITY_AUDIT_RETENTION_DAYS=2555

# Optional integrations
N8N_WEBHOOK_URL=
OSIRIS_ENABLED=false
HERMES_ENABLED=false
